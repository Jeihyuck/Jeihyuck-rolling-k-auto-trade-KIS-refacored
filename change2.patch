             for row in rows:
                 code = str(row.get("code") or "").zfill(6)
                 if not code:
                     continue
                 writer.writerow({"code": code, "name": (row.get("name") or "").strip()})
     except Exception:
         logger.exception("[UNIVERSE][SEED][WRITE_FAIL] path=%s", path)
         raise
 
