 def _unique_archive_path(archive_dir: Path, name: str) -> Path:
     candidate = archive_dir / name
     if not candidate.exists():
         return candidate
     stamp = datetime.now().strftime("%Y%m%d%H%M%S")
     return archive_dir / f"{name}_{stamp}"
 
 
