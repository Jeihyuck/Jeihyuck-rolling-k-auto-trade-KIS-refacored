+        if code:
+            conditions.append(self._schema.fills.c.code == code)
+        stmt = select(self._schema.fills).where(and_(*conditions))
+        with self.engine.begin() as conn:
+            rows = conn.execute(stmt).mappings().all()
+        return [dict(r) for r in rows]
