 def _strip_sql_comments(sql: str) -> str:
     sql = re.sub(r"/\*.*?\*/", "", sql, flags=re.S)
     out_lines = []
     for line in sql.splitlines():
         stripped = line.strip()
         if not stripped:
             continue
         if stripped.startswith("--"):
             continue
         if "--" in line:
             line = line.split("--", 1)[0]
         out_lines.append(line)
     return "\n".join(out_lines).strip()
 
 
