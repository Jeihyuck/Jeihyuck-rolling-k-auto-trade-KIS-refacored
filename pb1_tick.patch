+        try:
+            cutoff_time = datetime.strptime(raw, "%H:%M").time()
+        except ValueError:
+            logger.warning("[PB1][ENV] invalid ENTRY_CUTOFF_TIME=%s fallback=%s", raw, PB1_ENTRY_WINDOW_END)
