 def git_push(remote: str, branch: str, cwd: str) -> Tuple[bool, str]:
     rc, out = _run_git(["git", "push", remote, f"HEAD:{branch}"], cwd=cwd, check=False)
     ok = rc == 0
     return ok, out
 
 
