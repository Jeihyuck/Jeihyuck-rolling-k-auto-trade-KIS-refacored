 def check_universe_ready(today: date) -> dict[str, bool]:
     ok, meta = universe_check(today.isoformat())
     return {
         "db_ok": meta.get("have_today", False),
         "lkg_ok": meta.get("have_lkg", False),
         "ok": ok,
     }
 
 
