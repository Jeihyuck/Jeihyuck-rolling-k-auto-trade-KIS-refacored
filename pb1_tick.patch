 def _parse_side(row: dict) -> str:
     raw = str(_first_value(row, ["sll_buy_dvsn_cd", "sll_buy_dvsn", "buy_sell_gb", "side"]) or "").strip()
     if raw in {"01", "1", "SELL", "S"} or "매도" in raw.upper():
         return "SELL"
     if raw in {"02", "2", "BUY", "B"} or "매수" in raw.upper():
         return "BUY"
     return "UNKNOWN"
 
 
