+    key = _breaker_key(method, url)
+    now_ts = time.time()
+    with _KIS_BREAKER_LOCK:
+        state = _load_breaker_state()
+        entry = state.setdefault("endpoints", {}).setdefault(key, {})
+        failures = entry.get("failures") or []
+        if not isinstance(failures, list):
