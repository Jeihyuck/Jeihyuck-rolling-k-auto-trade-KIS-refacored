     if normalized in {"LIVE", "EXECUTE", "EXECUTION"}:
         return "LIVE"
     if normalized in {"DIAG", "DIAGNOSTIC", "INTENT_ONLY", "INTENT"}:
         return "DIAG"
     return None
 
 
