+_BOTSTATE_ROOT = get_botstate_root()
+_CACHE_ROOT = get_cache_root()
+logger.info("[BOTSTATE][PATHS] root=%s cache_root=%s", _BOTSTATE_ROOT, _CACHE_ROOT)
