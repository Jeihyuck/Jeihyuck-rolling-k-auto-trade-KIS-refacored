@@ -68,53 +68,59 @@ jobs:
       BOTSTATE_LOCK_RETRY_SLEEP_SEC: "5"
 
       ACTIVE_STRATEGIES: "1"
       DAILY_CAPITAL: "250000000"
 
     steps:
       - name: Checkout code (always run nullim code)
         uses: actions/checkout@v4
         with:
           fetch-depth: 0
           ref: "nullim"
           path: repo
 
       - name: Checkout bot-state branch
         uses: actions/checkout@v4
         with:
           fetch-depth: 0
           ref: "bot-state"
           path: botstate
 
       - name: Restore bot_state into workspace
         run: |
           set -euo pipefail
           mkdir -p bot_state
           if [ -d ../botstate/bot_state ]; then
-            rsync -a --delete --exclude='.gitkeep' ../botstate/bot_state/ bot_state/
+            rsync -a --delete --exclude='.gitignore' ../botstate/bot_state/ bot_state/
           fi
           echo "[RESTORE] repo/bot_state restored"
+          ls -al bot_state/.gitignore
+          git status --porcelain
+          if [ ! -f bot_state/.gitignore ]; then
+            echo "::error::Missing bot_state/.gitignore after restore"
+            exit 1
+          fi
 
       - name: Setup Python
         uses: actions/setup-python@v5
         with:
           python-version: "3.11"
 
       - name: Install deps
         working-directory: repo
         run: |
           set -euo pipefail
           python -m pip install --upgrade pip
           if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
 
       - name: Precheck env (fail fast)
         working-directory: repo
         run: |
           set -euo pipefail
           echo "[PRECHECK] KIS_ENV=${KIS_ENV:-}"
           for k in APP_KEY APP_SECRET API_BASE_URL CANO ACNT_PRDT_CD KIS_ENV; do
             if [ -z "${!k:-}" ]; then
               echo "::error::Missing required secret/env: $k"
               exit 1
             fi
           done
           python -c "import importlib; importlib.import_module('trader.pb1_runner'); print('[PRECHECK] pb1_runner import ok')"
