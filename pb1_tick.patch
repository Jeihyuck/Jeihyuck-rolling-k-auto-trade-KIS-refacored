 def _chmod_rw(path: Path) -> None:
     try:
         if path.is_dir():
             targets = [path] + list(path.rglob("*"))
         else:
             targets = [path]
         for target in targets:
             try:
                 os.chmod(
                     target,
                     target.stat().st_mode | stat.S_IWUSR | stat.S_IRUSR,
                 )
             except Exception:
                 continue
     except Exception:
         pass
 
 
