     """Best-effort parse for YYYY-MM-DD or YYYYMMDD."""
     from datetime import datetime as _datetime
 
     if not val:
         return None
     s = str(val).strip()
     try:
         if "-" in s:
             return _datetime.fromisoformat(s).date()
         if len(s) == 8 and s.isdigit():
             return _datetime.strptime(s, "%Y%m%d").date()
         return _datetime.fromisoformat(s).date()
