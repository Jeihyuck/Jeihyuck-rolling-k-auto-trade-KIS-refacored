 def _compute_migration_version(migrations_dir: str) -> str:
     hasher = hashlib.sha256()
     hasher.update(MIGRATION_VERSION.encode("utf-8"))
     migration_files = sorted(Path(migrations_dir).glob("*.sql"))
     for path in migration_files:
