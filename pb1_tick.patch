diff --git a/.github/workflows/trade-runner.yml b/.github/workflows/trade-runner.yml
index ab8ea8e9fb9dd6f3818cfeabd5bb14f3665551d9..54738faf19bf3e997cfc3db4b4d809c2dc4bc274 100644
--- a/.github/workflows/trade-runner.yml
+++ b/.github/workflows/trade-runner.yml
@@ -158,51 +158,51 @@ jobs:
               pb1_phase = force_phase
           else:
               pb1_phase = "entry" if window in {"preopen", "morning", "day"} else "exit"
 
           print(
               f"[AUTO] now={now.isoformat()} trading_day={is_weekday} window={window} "
               f"in_market={in_market} -> STRATEGY_MODE={mode} PB1_PHASE_DEFAULT={pb1_phase}"
           )
           with open(os.environ["GITHUB_ENV"], "a", encoding="utf-8") as f:
               f.write(f"EFFECTIVE_STRATEGY_MODE={mode}\n")
               f.write(f"TRADING_DAY={'true' if is_weekday else 'false'}\n")
               f.write(f"MARKET_WINDOW={window}\n")
               f.write(f"PB1_PHASE_DEFAULT={pb1_phase}\n")
           PY
 
       - name: Build universe (best_k_meta) - allow fallback
         working-directory: repo
         run: |
           set -euo pipefail
           python -m trader.universe.build --env "${KIS_ENV}" --strategy "best_k_meta" --date "$(date +%F)" || echo "[WARN] universe build failed (continue)"
 
       - name: Compile check
         working-directory: repo
         run: |
           set -euo pipefail
-          python -m compileall trader
+          python -m compileall -q trader
 
       - name: Configure git identity for botstate commits
         working-directory: repo
         run: |
           git config --global user.email "actions@github.com"
           git config --global user.name "github-actions[bot]"
 
       - name: Run PB1 (auto window) - should exit within 4 minutes
         working-directory: repo
         run: |
           set -euo pipefail
           echo "[RUN] STRATEGY_MODE=$EFFECTIVE_STRATEGY_MODE MARKET_WINDOW=$MARKET_WINDOW PB1_PHASE_DEFAULT=$PB1_PHASE_DEFAULT"
           python -m trader.run --window auto --phase auto
         env:
           STRATEGY_MODE: ${{ env.EFFECTIVE_STRATEGY_MODE }}
           LIVE_TRADING_ENABLED: "1"
 
       - name: Debug bot_state contents (after run)
         run: |
           set -euo pipefail
           echo "=== bot_state tree ==="
           find bot_state -maxdepth 3 -type f -print || true
           echo "=== git status (bot-state worktree if exists) ==="
           git status --porcelain || true
 
