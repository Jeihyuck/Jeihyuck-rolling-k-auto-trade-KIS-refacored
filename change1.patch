     "DATABASE_URL",             # common
     "TRADER_DB_URL",
     "DB_URL",
     "SQLALCHEMY_DATABASE_URL",
 )
 
 
 def _redact_url(url: str) -> str:
     # user:pass@host 형태에서 pass 노출 방지
     if "@" in url:
         left = url.split("@", 1)[0]
         return f"{left}@***"
     return (url[:24] + "***") if len(url) > 24 else (url + "***")
 
 
 def _pick_db_url() -> Tuple[str, str]:
     for key in DB_URL_KEYS:
         v = (os.getenv(key) or "").strip()
         if v:
             return v, key
     return "", ""
