     """
     Append JSON line.
     Always safe: best-effort, never crash trading loop.
     """
     try:
         p = event_path(as_of)
         p.parent.mkdir(parents=True, exist_ok=True)
         payload = {
             "ts": datetime.now().isoformat(),
             "as_of": as_of,
             "event": event,
             **fields,
         }
