-        stderr=subprocess.STDOUT,
-        text=True,
-    )
-    out = (p.stdout or "").strip()
-    if check and p.returncode != 0:
-        raise RuntimeError(f"git command failed: {' '.join(cmd)}\n{out}")
-    return p.returncode, out
