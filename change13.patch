diff --git a/tests/test_tick_runner_idempotency.py b/tests/test_tick_runner_idempotency.py
new file mode 100644
index 0000000000000000000000000000000000000000..23f27941aa3a143a87ca57e5282c3c727157a456
--- /dev/null
+++ b/tests/test_tick_runner_idempotency.py
@@ -0,0 +1,127 @@
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from trader import tick_runner
+from trader.persist.ledger_db import FillPayload, init_db
+
+
+class StubKis:
+    def __init__(self, positions=None):
+        self.positions = positions or []
+        self.orders: list[dict] = []
+
+    def get_open_orders(self):
+        return []
+
+    def get_recent_fills(self, since=None):
+        return []
+
+    def get_positions(self):
+        return list(self.positions)
+
+    def buy_stock_market(self, symbol, qty):
+        odno = f"ORD{len(self.orders)+1}"
+        resp = {"rt_cd": "0", "output": {"ODNO": odno}, "symbol": symbol, "qty": qty}
+        self.orders.append(resp)
+        return resp
+
+    def sell_stock_market(self, symbol, qty):
+        odno = f"ORD{len(self.orders)+1}"
+        resp = {"rt_cd": "0", "output": {"ODNO": odno}, "symbol": symbol, "qty": qty}
+        self.orders.append(resp)
+        return resp
+
+
+def _write_candidates(path: Path, *, signal_key: str = "sig-1"):
+    payload = [
+        {
+            "sid": 1,
+            "symbol": "005930",
+            "side": "BUY",
+            "qty": 10,
+            "price": None,
+            "order_type": "market",
+            "signal_key": signal_key,
+        }
+    ]
+    path.write_text(json.dumps(payload))
+
+
+def test_tick_runner_idempotent_orders(monkeypatch, tmp_path):
+    botstate_dir = tmp_path / "botstate"
+    candidates_path = tmp_path / "candidates.json"
+    db_path = tmp_path / "runtime" / "ledger.sqlite"
+    _write_candidates(candidates_path)
+    db_path.parent.mkdir(parents=True, exist_ok=True)
+
+    stub_first = StubKis()
+    monkeypatch.setattr(tick_runner, "KisAPI", lambda: stub_first)
+    monkeypatch.setenv("LEDGER_DB_PATH", str(db_path))
+    monkeypatch.setenv("BOTSTATE_DIR", str(botstate_dir))
+    monkeypatch.setenv("RUN_MODE", "TICK")
+    monkeypatch.setenv("LEDGER_BACKEND", "db")
+    monkeypatch.setattr(
+        sys,
+        "argv",
+        ["tick_runner", "--botstate", str(botstate_dir), "--candidates-path", str(candidates_path)],
+    )
+    tick_runner.main()
+    assert len(stub_first.orders) == 1
+
+    stub_second = StubKis()
+    monkeypatch.setattr(tick_runner, "KisAPI", lambda: stub_second)
+    monkeypatch.setattr(
+        sys,
+        "argv",
+        ["tick_runner", "--botstate", str(botstate_dir), "--candidates-path", str(candidates_path)],
+    )
+    tick_runner.main()
+    assert len(stub_second.orders) == 0
+
+
+def test_tick_runner_safe_mode_blocks_buy(monkeypatch, tmp_path):
+    botstate_dir = tmp_path / "botstate"
+    candidates_path = tmp_path / "candidates.json"
+    db_path = tmp_path / "runtime" / "ledger.sqlite"
+    _write_candidates(candidates_path, signal_key="safe-mode")
+    db_path.parent.mkdir(parents=True, exist_ok=True)
+
+    db = init_db(db_path)
+    db.apply_fill_to_lots(
+        FillPayload(
+            fill_uid="fill-1",
+            odno="ORD-1",
+            symbol="005930",
+            side="BUY",
+            qty=10,
+            price=70000,
+            ccld_dt="20240101",
+            ccld_tm="090000",
+            raw_json={"source": "test"},
+            sid=1,
+        )
+    )
+
+    stub = StubKis(positions=[{"pdno": "005930", "hldg_qty": 5, "sid": 1}])
+    monkeypatch.setattr(tick_runner, "KisAPI", lambda: stub)
+    monkeypatch.setenv("LEDGER_DB_PATH", str(db_path))
+    monkeypatch.setenv("BOTSTATE_DIR", str(botstate_dir))
+    monkeypatch.setenv("RUN_MODE", "TICK")
+    monkeypatch.setenv("LEDGER_BACKEND", "db")
+    monkeypatch.setattr(
+        sys,
+        "argv",
+        ["tick_runner", "--botstate", str(botstate_dir), "--candidates-path", str(candidates_path)],
+    )
+    tick_runner.main()
+    assert len(stub.orders) == 0
+
+    checkpoint_path = botstate_dir / "bot_state" / "ledger" / "checkpoints.json"
+    assert checkpoint_path.exists()
+    checkpoints = json.loads(checkpoint_path.read_text())
+    assert checkpoints.get("tick", {}).get("safe_mode") is True
