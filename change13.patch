+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import sqlite3
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Callable, Iterable, Tuple
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_DB_PATH = Path("runtime/ledger/ledger.sqlite")
+
+
+def _utcnow_str() -> str:
+    return datetime.utcnow().isoformat()
+
+
+@dataclass
+class FillPayload:
+    fill_uid: str
+    odno: str
+    symbol: str
+    side: str
+    qty: int
+    price: float
+    ccld_dt: str
+    ccld_tm: str
+    raw_json: dict[str, Any]
+    sid: int | None = None
+
+
+class LedgerDB:
+    def __init__(self, db_path: Path) -> None:
+        self.db_path = Path(db_path)
+        self.db_path.parent.mkdir(parents=True, exist_ok=True)
+        self.conn = sqlite3.connect(self.db_path, isolation_level=None)
+        self.conn.row_factory = sqlite3.Row
+        self._configure()
+        self._init_schema()
+
+    def _configure(self) -> None:
+        try:
+            self.conn.execute("PRAGMA journal_mode=WAL;")
+            self.conn.execute("PRAGMA foreign_keys=ON;")
+        except Exception:
+            logger.exception("[LEDGER-DB] pragma configure failed path=%s", self.db_path)
+
+    def _init_schema(self) -> None:
+        try:
+            self.conn.executescript(
+                """
+                CREATE TABLE IF NOT EXISTS fills (
+                    fill_uid TEXT PRIMARY KEY,
+                    odno TEXT,
+                    symbol TEXT,
+                    side TEXT,
+                    qty INTEGER,
+                    price REAL,
+                    ccld_dt TEXT,
+                    ccld_tm TEXT,
+                    raw_json TEXT,
+                    created_at TEXT
+                );
+                CREATE TABLE IF NOT EXISTS intents (
+                    intent_id TEXT PRIMARY KEY,
+                    sid INTEGER,
+                    symbol TEXT,
+                    side TEXT,
+                    signal_key TEXT,
+                    status TEXT,
+                    odno TEXT,
+                    created_at TEXT,
+                    updated_at TEXT
+                );
+                CREATE TABLE IF NOT EXISTS orders (
+                    odno TEXT PRIMARY KEY,
+                    intent_id TEXT,
+                    symbol TEXT,
+                    side TEXT,
+                    qty INTEGER,
+                    price REAL,
+                    status TEXT,
+                    raw_json TEXT,
+                    created_at TEXT,
+                    updated_at TEXT
+                );
+                CREATE TABLE IF NOT EXISTS lots (
+                    lot_id TEXT PRIMARY KEY,
+                    sid INTEGER,
+                    symbol TEXT,
+                    entry_dt TEXT,
+                    entry_tm TEXT,
+                    entry_px REAL,
+                    qty_open INTEGER,
+                    qty_remain INTEGER,
+                    meta_json TEXT,
+                    created_at TEXT,
+                    updated_at TEXT
+                );
+                CREATE TABLE IF NOT EXISTS checkpoints (
+                    key TEXT PRIMARY KEY,
+                    value_json TEXT,
+                    updated_at TEXT
+                );
+                """
+            )
+            logger.info("[LEDGER-DB] schema initialized path=%s", self.db_path)
+        except Exception:
+            logger.exception("[LEDGER-DB] schema init failed path=%s", self.db_path)
+            raise
+
+    @contextmanager
+    def tx(self):
+        cursor = self.conn.cursor()
+        try:
+            cursor.execute("BEGIN IMMEDIATE;")
+            yield cursor
+            self.conn.commit()
+        except Exception:
+            self.conn.rollback()
+            raise
+        finally:
+            cursor.close()
+
+    def with_tx(self, fn: Callable[[sqlite3.Cursor], Any]) -> Any:
+        with self.tx() as cur:
+            return fn(cur)
+
+    def upsert_intent(self, intent: dict[str, Any]) -> None:
+        payload = dict(intent)
+        now = _utcnow_str()
+        payload.setdefault("created_at", now)
+        payload["updated_at"] = now
+        try:
+            with self.tx() as cur:
+                cur.execute(
+                    """
+                    INSERT INTO intents (intent_id, sid, symbol, side, signal_key, status, odno, created_at, updated_at)
+                    VALUES (:intent_id, :sid, :symbol, :side, :signal_key, :status, :odno, :created_at, :updated_at)
+                    ON CONFLICT(intent_id) DO UPDATE SET
+                        sid=excluded.sid,
+                        symbol=excluded.symbol,
+                        side=excluded.side,
+                        signal_key=excluded.signal_key,
+                        status=excluded.status,
+                        odno=COALESCE(excluded.odno, intents.odno),
+                        updated_at=excluded.updated_at
+                    """,
+                    payload,
+                )
+            logger.info(
+                "[LEDGER-DB] upsert_intent ok intent_id=%s status=%s odno=%s",
+                payload.get("intent_id"),
+                payload.get("status"),
+                payload.get("odno"),
+            )
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] upsert_intent failed intent_id=%s reasons=[exception]",
+                payload.get("intent_id"),
+            )
+            raise
+
+    def set_intent_odno(self, intent_id: str, odno: str) -> None:
+        now = _utcnow_str()
+        try:
+            with self.tx() as cur:
+                cur.execute(
+                    """
+                    UPDATE intents
+                    SET odno=?, updated_at=?
+                    WHERE intent_id=?
+                    """,
+                    (odno, now, intent_id),
+                )
+            logger.info("[LEDGER-DB] set_intent_odno intent_id=%s odno=%s", intent_id, odno)
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] set_intent_odno failed intent_id=%s reasons=[exception]", intent_id
+            )
+            raise
+
+    def has_intent(self, intent_id: str) -> bool:
+        try:
+            cur = self.conn.execute("SELECT 1 FROM intents WHERE intent_id=? LIMIT 1;", (intent_id,))
+            exists = cur.fetchone() is not None
+            logger.info("[LEDGER-DB] has_intent intent_id=%s exists=%s", intent_id, exists)
+            return exists
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] has_intent failed intent_id=%s reasons=[exception]", intent_id
+            )
+            return False
+
+    def upsert_order(self, odno: str, *, intent_id: str | None, symbol: str, side: str, qty: int, price: float | None, status: str, raw_json: dict[str, Any] | None = None) -> None:
+        now = _utcnow_str()
+        payload = {
+            "odno": odno,
+            "intent_id": intent_id,
+            "symbol": symbol,
+            "side": side,
+            "qty": qty,
+            "price": price,
+            "status": status,
+            "raw_json": json.dumps(raw_json or {}, ensure_ascii=False),
+            "created_at": now,
+            "updated_at": now,
+        }
+        try:
+            with self.tx() as cur:
+                cur.execute(
+                    """
+                    INSERT INTO orders (odno, intent_id, symbol, side, qty, price, status, raw_json, created_at, updated_at)
+                    VALUES (:odno, :intent_id, :symbol, :side, :qty, :price, :status, :raw_json, :created_at, :updated_at)
+                    ON CONFLICT(odno) DO UPDATE SET
+                        intent_id=COALESCE(excluded.intent_id, orders.intent_id),
+                        symbol=excluded.symbol,
+                        side=excluded.side,
+                        qty=excluded.qty,
+                        price=COALESCE(excluded.price, orders.price),
+                        status=excluded.status,
+                        raw_json=excluded.raw_json,
+                        updated_at=excluded.updated_at
+                    """,
+                    payload,
+                )
+            logger.info(
+                "[LEDGER-DB] upsert_order ok odno=%s intent_id=%s status=%s", odno, intent_id, status
+            )
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] upsert_order failed odno=%s reasons=[exception]", odno
+            )
+            raise
+
+    def insert_fill_once(self, fill_uid: str, *, odno: str, symbol: str, side: str, qty: int, price: float, ccld_dt: str, ccld_tm: str, raw_json: dict[str, Any]) -> bool:
+        payload = {
+            "fill_uid": fill_uid,
+            "odno": odno,
+            "symbol": symbol,
+            "side": side,
+            "qty": qty,
+            "price": price,
+            "ccld_dt": ccld_dt,
+            "ccld_tm": ccld_tm,
+            "raw_json": json.dumps(raw_json or {}, ensure_ascii=False),
+            "created_at": _utcnow_str(),
+        }
+        try:
+            with self.tx() as cur:
+                cur.execute(
+                    """
+                    INSERT OR IGNORE INTO fills (fill_uid, odno, symbol, side, qty, price, ccld_dt, ccld_tm, raw_json, created_at)
+                    VALUES (:fill_uid, :odno, :symbol, :side, :qty, :price, :ccld_dt, :ccld_tm, :raw_json, :created_at)
+                    """,
+                    payload,
+                )
+                inserted = cur.rowcount > 0
+            logger.info(
+                "[LEDGER-DB] insert_fill_once %s fill_uid=%s odno=%s symbol=%s qty=%s price=%s",
+                "ok" if inserted else "dup",
+                fill_uid,
+                odno,
+                symbol,
+                qty,
+                price,
+            )
+            return inserted
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] insert_fill_once failed fill_uid=%s reasons=[exception]", fill_uid
+            )
+            return False
+
+    def _generate_lot_id(self, fill_uid: str, symbol: str, sid: int | None) -> str:
+        base = f"{fill_uid}|{symbol}|{sid or 0}"
+        return hashlib.sha1(base.encode("utf-8")).hexdigest()
+
+    def _existing_lots(self, symbol: str, sid: int | None) -> list[sqlite3.Row]:
+        try:
+            cur = self.conn.execute(
+                "SELECT * FROM lots WHERE symbol=? AND (sid=? OR (? IS NULL AND sid IS NULL)) ORDER BY entry_dt, entry_tm;",
+                (symbol, sid, sid),
+            )
+            return list(cur.fetchall())
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] load lots failed symbol=%s sid=%s reasons=[exception]", symbol, sid
+            )
+            return []
+
+    def apply_fill_to_lots(self, fill: FillPayload) -> None:
+        side = (fill.side or "").upper()
+        symbol = fill.symbol
+        sid = fill.sid
+        reasons: list[str] = []
+        try:
+            if side == "BUY":
+                lot_id = self._generate_lot_id(fill.fill_uid, symbol, sid)
+                meta = {"source_fill": fill.raw_json, "fill_uid": fill.fill_uid}
+                payload = {
+                    "lot_id": lot_id,
+                    "sid": sid,
+                    "symbol": symbol,
+                    "entry_dt": fill.ccld_dt,
+                    "entry_tm": fill.ccld_tm,
+                    "entry_px": float(fill.price),
+                    "qty_open": int(fill.qty),
+                    "qty_remain": int(fill.qty),
+                    "meta_json": json.dumps(meta, ensure_ascii=False),
+                    "created_at": _utcnow_str(),
+                    "updated_at": _utcnow_str(),
+                }
+                with self.tx() as cur:
+                    cur.execute(
+                        """
+                        INSERT INTO lots (lot_id, sid, symbol, entry_dt, entry_tm, entry_px, qty_open, qty_remain, meta_json, created_at, updated_at)
+                        VALUES (:lot_id, :sid, :symbol, :entry_dt, :entry_tm, :entry_px, :qty_open, :qty_remain, :meta_json, :created_at, :updated_at)
+                        ON CONFLICT(lot_id) DO UPDATE SET
+                            qty_open=lots.qty_open + excluded.qty_open,
+                            qty_remain=lots.qty_remain + excluded.qty_remain,
+                            updated_at=excluded.updated_at
+                        """,
+                        payload,
+                    )
+                logger.info(
+                    "[LEDGER-DB] apply_fill_to_lots buy lot_id=%s qty=%s symbol=%s sid=%s",
+                    payload["lot_id"],
+                    payload["qty_open"],
+                    symbol,
+                    sid,
+                )
+                return
+
+            if side == "SELL":
+                remaining_to_close = int(fill.qty)
+                lots = self._existing_lots(symbol, sid)
+                with self.tx() as cur:
+                    for lot in lots:
+                        if remaining_to_close <= 0:
+                            break
+                        lot_qty = int(lot["qty_remain"] or 0)
+                        if lot_qty <= 0:
+                            continue
+                        consume = min(lot_qty, remaining_to_close)
+                        new_qty = lot_qty - consume
+                        cur.execute(
+                            "UPDATE lots SET qty_remain=?, updated_at=? WHERE lot_id=?",
+                            (new_qty, _utcnow_str(), lot["lot_id"]),
+                        )
+                        remaining_to_close -= consume
+                    if remaining_to_close > 0:
+                        reasons.append(f"remaining_unclosed={remaining_to_close}")
+                logger.info(
+                    "[LEDGER-DB] apply_fill_to_lots sell symbol=%s sid=%s filled=%s remaining=%s reasons=%s",
+                    symbol,
+                    sid,
+                    fill.qty - max(remaining_to_close, 0),
+                    remaining_to_close,
+                    reasons or ["ok"],
+                )
+                return
+
+            reasons.append(f"unsupported_side={side}")
+            logger.warning(
+                "[LEDGER-DB] apply_fill_to_lots skip fill_uid=%s symbol=%s side=%s reasons=%s",
+                fill.fill_uid,
+                symbol,
+                side,
+                reasons,
+            )
+        except Exception:
+            logger.exception(
+                "[LEDGER-DB] apply_fill_to_lots error fill_uid=%s symbol=%s side=%s reasons=[exception]",
+                fill.fill_uid,
+                symbol,
+                side,
+            )
+
+    def set_checkpoint(self, key: str, value_dict: dict[str, Any]) -> None:
+        now = _utcnow_str()
+        try:
+            with self.tx() as cur:
+                cur.execute(
+                    """
+                    INSERT INTO checkpoints (key, value_json, updated_at)
+                    VALUES (?, ?, ?)
+                    ON CONFLICT(key) DO UPDATE SET
+                        value_json=excluded.value_json,
+                        updated_at=excluded.updated_at
+                    """,
+                    (key, json.dumps(value_dict, ensure_ascii=False), now),
+                )
+            logger.info("[LEDGER-DB] checkpoint set key=%s", key)
+        except Exception:
+            logger.exception("[LEDGER-DB] checkpoint set failed key=%s reasons=[exception]", key)
+            raise
+
+    def get_checkpoint(self, key: str) -> dict[str, Any] | None:
+        try:
+            cur = self.conn.execute("SELECT value_json FROM checkpoints WHERE key=?;", (key,))
+            row = cur.fetchone()
+            if not row:
+                logger.info("[LEDGER-DB] checkpoint miss key=%s", key)
+                return None
+            raw = row["value_json"]
+            try:
+                value = json.loads(raw) if raw else None
+            except Exception:
+                value = None
+            logger.info("[LEDGER-DB] checkpoint hit key=%s", key)
+            return value if isinstance(value, dict) else None
+        except Exception:
+            logger.exception("[LEDGER-DB] checkpoint get failed key=%s reasons=[exception]", key)
+            return None
+
+    def dump_checkpoints(self) -> dict[str, Any]:
+        payload: dict[str, Any] = {}
+        try:
+            cur = self.conn.execute("SELECT key, value_json FROM checkpoints;")
+            for row in cur.fetchall():
+                raw = row["value_json"]
+                try:
+                    payload[row["key"]] = json.loads(raw) if raw else {}
+                except Exception:
+                    payload[row["key"]] = {}
+            logger.info("[LEDGER-DB] dump_checkpoints count=%s", len(payload))
+        except Exception:
+            logger.exception("[LEDGER-DB] dump_checkpoints failed reasons=[exception]")
+        return payload
+
+
+def init_db(db_path: str | Path = DEFAULT_DB_PATH) -> LedgerDB:
+    return LedgerDB(Path(db_path))
+
+
+def with_tx(db: LedgerDB, fn: Callable[[sqlite3.Cursor], Any]) -> Any:
+    return db.with_tx(fn)
