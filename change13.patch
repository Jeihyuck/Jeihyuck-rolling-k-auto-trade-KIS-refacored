+                        position_id=_coerce_uuid(None),
+                        env=env,
+                        strategy=strategy,
+                        sid=sid,
+                        mode=mode,
+                        code=code,
+                        market=market,
+                        qty=values["qty"],
+                        avg_buy_price=values["avg_buy_price"],
+                        total_cost=values["total_cost"],
+                        realized_pnl=values["realized_pnl"],
+                        last_trade_at=filled_at,
+                    )
+                )
