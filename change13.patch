     worktree_dir = worktree_dir.resolve()
     lock_path = _lock_path(worktree_dir)
     if lock_path.exists():
         lock_path.unlink()
         lock_rel_path = lock_path.relative_to(worktree_dir)
         _git(worktree_dir, "add", "-u", str(lock_rel_path))
