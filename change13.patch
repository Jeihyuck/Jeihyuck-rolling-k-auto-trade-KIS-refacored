@@ -0,0 +1,313 @@
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import logging
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Dict, Iterable, List
+
+from trader.engine.reconcile import reconcile_fills, reconcile_open_orders, reconcile_positions
+from trader.kis_wrapper import KisAPI
+from trader.persist.event_store import EventStore
+from trader.persist.ledger_db import LedgerDB, init_db
+from trader.time_utils import now_kst
+
+logger = logging.getLogger(__name__)
+logging.basicConfig(level=logging.INFO)
+
+
+@dataclass
+class Candidate:
+    sid: int
+    symbol: str
+    side: str
+    qty: int
+    price: float | None
+    order_type: str
+    signal_key: str
+
+
+def _intent_id(trade_date: str, candidate: Candidate) -> str:
+    raw = f"{trade_date}{candidate.sid}{candidate.symbol}{candidate.side.upper()}{candidate.signal_key}"
+    return hashlib.sha1(raw.encode("utf-8")).hexdigest()
+
+
+def _load_candidates(path: str | None) -> List[Candidate]:
+    if not path:
+        return []
+    fp = Path(path)
+    if not fp.exists():
+        logger.warning("[SETUP-BAD] candidate path missing path=%s reasons=%s", fp, ["file_missing"])
+        return []
+    try:
+        data = json.loads(fp.read_text())
+    except Exception:
+        logger.exception("[SETUP-BAD] failed to load candidates path=%s reasons=%s", fp, ["json_error"])
+        return []
+    items: List[Candidate] = []
+    for idx, row in enumerate(data if isinstance(data, list) else []):
+        try:
+            cand = Candidate(
+                sid=int(row.get("sid")),
+                symbol=str(row.get("symbol") or "").zfill(6),
+                side=str(row.get("side") or "").upper(),
+                qty=int(row.get("qty") or 0),
+                price=float(row["price"]) if row.get("price") is not None else None,
+                order_type=str(row.get("order_type") or "market"),
+                signal_key=str(row.get("signal_key") or ""),
+            )
+            items.append(cand)
+        except Exception as exc:
+            logger.warning(
+                "[SETUP-BAD] skip candidate idx=%s reasons=%s", idx, [f"parse_error:{exc}"]
+            )
+    return items
+
+
+def _resolve_botstate_dir(path: str | None) -> Path:
+    resolved = Path(path or os.getenv("BOTSTATE_DIR", "_botstate")).resolve()
+    resolved.mkdir(parents=True, exist_ok=True)
+    target = resolved / "bot_state"
+    target.mkdir(parents=True, exist_ok=True)
+    return target
+
+
+def _write_checkpoints_file(base_dir: Path, db: LedgerDB) -> Path:
+    checkpoints = db.dump_checkpoints()
+    path = base_dir / "ledger" / "checkpoints.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(".json.tmp")
+    tmp.write_text(json.dumps(checkpoints, ensure_ascii=False, indent=2))
+    tmp.replace(path)
+    logger.info("[TICK] checkpoints persisted path=%s", path)
+    return path
+
+
+def _extract_odno(resp: Dict[str, Any] | None) -> str:
+    if not isinstance(resp, dict):
+        return ""
+    output = resp.get("output") or resp.get("output1") or {}
+    if isinstance(output, dict):
+        return str(output.get("ODNO") or output.get("ord_no") or output.get("odno") or "")
+    return ""
+
+
+def _order_ok(resp: Dict[str, Any] | None) -> bool:
+    if not isinstance(resp, dict):
+        return False
+    if str(resp.get("rt_cd") or "").strip() == "0":
+        return True
+    status = str(resp.get("status") or "").upper()
+    return status == "OK"
+
+
+def _send_order(kis: KisAPI, candidate: Candidate) -> Dict[str, Any] | None:
+    try:
+        if candidate.side == "BUY":
+            if candidate.order_type == "limit" and candidate.price:
+                return kis.buy_stock_limit(candidate.symbol, candidate.qty, int(candidate.price))
+            return kis.buy_stock_market(candidate.symbol, candidate.qty)
+        if candidate.side == "SELL":
+            if candidate.order_type == "limit" and candidate.price:
+                return kis.sell_stock_limit(candidate.symbol, candidate.qty, int(candidate.price))
+            return kis.sell_stock_market(candidate.symbol, candidate.qty)
+    except Exception as exc:
+        logger.exception("[ORDER] send failed symbol=%s side=%s reasons=%s", candidate.symbol, candidate.side, [str(exc)])
+        return {"status": "ERROR", "reason": str(exc)}
+    return None
+
+
+def _append_order_event(
+    store: EventStore,
+    *,
+    event_type: str,
+    intent_id: str,
+    odno: str,
+    candidate: Candidate,
+    resp: Dict[str, Any] | None,
+    reasons: Iterable[str],
+) -> None:
+    store.append_event(
+        "orders",
+        {
+            "type": event_type,
+            "intent_id": intent_id,
+            "odno": odno,
+            "symbol": candidate.symbol,
+            "side": candidate.side,
+            "qty": candidate.qty,
+            "signal_key": candidate.signal_key,
+            "reasons": list(reasons),
+            "payload": resp or {},
+        },
+    )
+
+
+def _process_candidates(
+    *,
+    candidates: List[Candidate],
+    db: LedgerDB,
+    kis: KisAPI,
+    event_store: EventStore,
+    trade_date: str,
+    safe_mode: bool,
+) -> None:
+    for cand in candidates:
+        reasons: List[str] = []
+        cand.side = cand.side.upper()
+        if not cand.signal_key:
+            reasons.append("signal_key_missing")
+        if cand.qty <= 0:
+            reasons.append("qty_invalid")
+        if cand.side not in {"BUY", "SELL"}:
+            reasons.append("side_invalid")
+        if safe_mode and cand.side == "BUY":
+            reasons.append("safe_mode_active")
+        intent_id = _intent_id(trade_date, cand)
+        if db.has_intent(intent_id):
+            logger.info(
+                "[INTENT] skip exists intent_id=%s symbol=%s side=%s", intent_id, cand.symbol, cand.side
+            )
+            continue
+        if reasons:
+            logger.error("[SETUP-BAD] intent_id=%s reasons=%s", intent_id, reasons)
+            continue
+
+        db.upsert_intent(
+            {
+                "intent_id": intent_id,
+                "sid": cand.sid,
+                "symbol": cand.symbol,
+                "side": cand.side,
+                "signal_key": cand.signal_key,
+                "status": "NEW",
+                "odno": None,
+            }
+        )
+
+        resp = _send_order(kis, cand)
+        if _order_ok(resp):
+            odno = _extract_odno(resp)
+            db.upsert_intent(
+                {
+                    "intent_id": intent_id,
+                    "sid": cand.sid,
+                    "symbol": cand.symbol,
+                    "side": cand.side,
+                    "signal_key": cand.signal_key,
+                    "status": "SENT",
+                    "odno": odno,
+                }
+            )
+            db.upsert_order(
+                odno or intent_id,
+                intent_id=intent_id,
+                symbol=cand.symbol,
+                side=cand.side,
+                qty=cand.qty,
+                price=cand.price,
+                status="SENT",
+                raw_json=resp or {},
+            )
+            _append_order_event(
+                event_store,
+                event_type="ORDER",
+                intent_id=intent_id,
+                odno=odno,
+                candidate=cand,
+                resp=resp,
+                reasons=["ok"],
+            )
+            logger.info("[ORDER] sent intent_id=%s odno=%s", intent_id, odno)
+        else:
+            reason = resp.get("reason") if isinstance(resp, dict) else "unknown"
+            db.upsert_intent(
+                {
+                    "intent_id": intent_id,
+                    "sid": cand.sid,
+                    "symbol": cand.symbol,
+                    "side": cand.side,
+                    "signal_key": cand.signal_key,
+                    "status": "REJECTED",
+                    "odno": None,
+                }
+            )
+            _append_order_event(
+                event_store,
+                event_type="ORDER_REJECT",
+                intent_id=intent_id,
+                odno="",
+                candidate=cand,
+                resp=resp,
+                reasons=[str(reason or "order_rejected")],
+            )
+            logger.error(
+                "[ORDER] reject intent_id=%s symbol=%s reasons=%s", intent_id, cand.symbol, [reason or "order_rejected"]
+            )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Nullim tick runner (db-backed ledger)")
+    parser.add_argument("--botstate", default=os.getenv("BOTSTATE_DIR", "_botstate"), help="Bot-state worktree directory")
+    parser.add_argument("--candidates-path", help="Optional JSON file containing candidate orders")
+    args = parser.parse_args()
+
+    os.environ.setdefault("LEDGER_BACKEND", "db")
+    os.environ.setdefault("RUN_MODE", "TICK")
+    os.environ.setdefault("BOTSTATE_DIR", args.botstate)
+
+    logger.info("[TICK] start botstate=%s run_mode=%s", args.botstate, os.getenv("RUN_MODE"))
+    bot_state_dir = _resolve_botstate_dir(args.botstate)
+    event_store = EventStore(bot_state_dir / "ledger")
+
+    db_path = Path(os.getenv("LEDGER_DB_PATH", "runtime/ledger/ledger.sqlite"))
+    db = init_db(db_path)
+    kis = KisAPI()
+
+    fill_checkpoint = db.get_checkpoint("fills") or {}
+    open_result = reconcile_open_orders(kis, db, fill_checkpoint)
+    fill_result = reconcile_fills(kis, db, fill_checkpoint)
+    pos_result = reconcile_positions(kis, db)
+    safe_mode = bool(pos_result.get("safe_mode"))
+
+    event_store.append_event(
+        "health",
+        {
+            "type": "HEALTH",
+            "payload": {
+                "open_orders": open_result,
+                "fills": fill_result,
+                "positions": pos_result,
+            },
+            "reasons": ["tick_start"],
+        },
+    )
+
+    candidates = _load_candidates(args.candidates_path)
+    trade_date = now_kst().strftime("%Y%m%d")
+    _process_candidates(
+        candidates=candidates,
+        db=db,
+        kis=kis,
+        event_store=event_store,
+        trade_date=trade_date,
+        safe_mode=safe_mode,
+    )
+
+    db.set_checkpoint(
+        "tick",
+        {
+            "ts": now_kst().isoformat(),
+            "safe_mode": safe_mode,
+            "candidates": len(candidates),
+        },
+    )
+    _write_checkpoints_file(bot_state_dir, db)
+    logger.info("[TICK] end safe_mode=%s", safe_mode)
+
+
+if __name__ == "__main__":
+    main()
