diff --git a/trader/engine/reconcile.py b/trader/engine/reconcile.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe4c44ecb018c70f95bfe2303a6174ddf293db65
--- /dev/null
+++ b/trader/engine/reconcile.py
@@ -0,0 +1,180 @@
+from __future__ import annotations
+
+import hashlib
+import logging
+from collections import defaultdict
+from datetime import datetime
+from typing import Any, Dict, Iterable, List, Tuple
+
+from trader.persist.ledger_db import FillPayload, LedgerDB
+
+logger = logging.getLogger(__name__)
+
+
+def _safe_str(value: Any) -> str:
+    return "" if value is None else str(value)
+
+
+def _build_fill_uid(fill: dict[str, Any]) -> str:
+    odno = _safe_str(fill.get("odno") or fill.get("order_no"))
+    fill_no = _safe_str(fill.get("ccld_no") or fill.get("fill_no"))
+    if odno and fill_no:
+        return f"{odno}-{fill_no}"
+    payload = f"{odno}|{_safe_str(fill.get('ccld_dt'))}|{_safe_str(fill.get('ccld_tm'))}|{_safe_str(fill.get('qty'))}|{_safe_str(fill.get('price'))}"
+    return hashlib.sha1(payload.encode("utf-8")).hexdigest()
+
+
+def reconcile_open_orders(kis: Any, db: LedgerDB, checkpoint: Dict[str, Any] | None) -> Dict[str, Any]:
+    orders: List[dict[str, Any]] = []
+    try:
+        orders = list(kis.get_open_orders()) if hasattr(kis, "get_open_orders") else []
+    except Exception as exc:
+        logger.exception("[RECONCILE-OPEN] failed reasons=[exception] detail=%s", exc)
+        return {"count": 0, "new": 0}
+
+    new = 0
+    for order in orders:
+        odno = _safe_str(order.get("odno") or order.get("order_no"))
+        symbol = _safe_str(order.get("symbol") or order.get("pdno"))
+        side = _safe_str(order.get("side") or order.get("ord_dvsn") or order.get("sll_buy_dvsn_cd")).upper()
+        qty = int(order.get("qty") or order.get("ord_qty") or order.get("qty_remain") or 0)
+        status = _safe_str(order.get("status") or order.get("ord_sts")).upper() or "OPEN"
+        intent_id = order.get("intent_id")
+        price_raw = order.get("price") or order.get("ord_unpr")
+        try:
+            price = float(price_raw) if price_raw is not None else None
+        except Exception:
+            price = None
+        db.upsert_order(
+            odno,
+            intent_id=intent_id,
+            symbol=symbol,
+            side=side,
+            qty=qty,
+            price=price,
+            status=status,
+            raw_json=order,
+        )
+        if intent_id:
+            db.set_intent_odno(intent_id, odno)
+        new += 1
+    logger.info("[RECONCILE-OPEN] count=%s new=%s", len(orders), new)
+    return {"count": len(orders), "new": new}
+
+
+def reconcile_fills(kis: Any, db: LedgerDB, checkpoint: Dict[str, Any] | None) -> Dict[str, Any]:
+    fills: List[dict[str, Any]] = []
+    since = None
+    if checkpoint:
+        since = checkpoint.get("last_fill_ts") or checkpoint.get("last_fill_dt")
+    try:
+        if hasattr(kis, "get_recent_fills"):
+            fills = list(kis.get_recent_fills(since=since))
+    except Exception as exc:
+        logger.exception("[RECONCILE-FILL] failed reasons=[exception] detail=%s", exc)
+        return {"total": 0, "applied": 0, "dup": 0}
+
+    applied = 0
+    dup = 0
+    last_ts: str | None = None
+    for fill in fills:
+        fill_uid = _build_fill_uid(fill)
+        odno = _safe_str(fill.get("odno") or fill.get("order_no"))
+        symbol = _safe_str(fill.get("symbol") or fill.get("pdno"))
+        side = _safe_str(fill.get("side") or fill.get("sll_buy_dvsn_cd")).upper()
+        try:
+            qty = int(fill.get("qty") or fill.get("ccld_qty") or fill.get("ord_qty") or 0)
+        except Exception:
+            qty = 0
+        try:
+            price = float(fill.get("price") or fill.get("ccld_unpr") or 0.0)
+        except Exception:
+            price = 0.0
+        ccld_dt = _safe_str(fill.get("ccld_dt") or fill.get("ccld_date") or datetime.utcnow().strftime("%Y%m%d"))
+        ccld_tm = _safe_str(fill.get("ccld_tm") or fill.get("ccld_time") or datetime.utcnow().strftime("%H%M%S"))
+        if db.insert_fill_once(
+            fill_uid,
+            odno=odno,
+            symbol=symbol,
+            side=side,
+            qty=qty,
+            price=price,
+            ccld_dt=ccld_dt,
+            ccld_tm=ccld_tm,
+            raw_json=fill,
+        ):
+            applied += 1
+            db.apply_fill_to_lots(
+                FillPayload(
+                    fill_uid=fill_uid,
+                    odno=odno,
+                    symbol=symbol,
+                    side=side,
+                    qty=qty,
+                    price=price,
+                    ccld_dt=ccld_dt,
+                    ccld_tm=ccld_tm,
+                    raw_json=fill,
+                    sid=fill.get("sid"),
+                )
+            )
+        else:
+            dup += 1
+        last_ts = fill.get("ts") or fill.get("ccld_ts") or ccld_dt + ccld_tm
+    if last_ts:
+        db.set_checkpoint("fills", {"last_fill_ts": last_ts})
+    logger.info("[RECONCILE-FILL] total=%s applied=%s dup=%s", len(fills), applied, dup)
+    return {"total": len(fills), "applied": applied, "dup": dup, "last_ts": last_ts}
+
+
+def reconcile_positions(kis: Any, db: LedgerDB) -> Dict[str, Any]:
+    positions: List[dict[str, Any]] = []
+    try:
+        positions = list(kis.get_positions()) if hasattr(kis, "get_positions") else []
+    except Exception as exc:
+        logger.exception("[RECONCILE-POS] failed reasons=[exception] detail=%s", exc)
+        return {"safe_mode": True, "mismatches": [{"reason": "positions_unavailable", "detail": str(exc)}]}
+
+    ledger_qty: Dict[Tuple[str, Any], int] = defaultdict(int)
+    try:
+        cur = db.conn.execute(
+            "SELECT symbol, sid, SUM(qty_remain) as qty FROM lots GROUP BY symbol, sid;"
+        )
+        for row in cur.fetchall():
+            ledger_qty[(row["symbol"], row["sid"])] = int(row["qty"] or 0)
+    except Exception:
+        logger.exception("[RECONCILE-POS] failed to aggregate lots reasons=[exception]")
+
+    mismatches: List[dict[str, Any]] = []
+    for pos in positions:
+        symbol = _safe_str(pos.get("symbol") or pos.get("pdno"))
+        sid = pos.get("sid")
+        try:
+            qty = int(pos.get("qty") or pos.get("hldg_qty") or pos.get("ord_psbl_qty") or 0)
+        except Exception:
+            qty = 0
+        ledger_q = ledger_qty.get((symbol, sid), 0)
+        if qty != ledger_q:
+            mismatches.append(
+                {
+                    "symbol": symbol,
+                    "sid": sid,
+                    "ledger_qty": ledger_q,
+                    "broker_qty": qty,
+                }
+            )
+    safe_mode = bool(mismatches)
+    if safe_mode:
+        for mismatch in mismatches:
+            logger.warning(
+                "[RECONCILE-POS] mismatch symbol=%s sid=%s ledger_qty=%s broker_qty=%s",
+                mismatch.get("symbol"),
+                mismatch.get("sid"),
+                mismatch.get("ledger_qty"),
+                mismatch.get("broker_qty"),
+            )
+        logger.error("[SAFE_MODE] activated reasons=%s", mismatches)
+    else:
+        logger.info("[RECONCILE-POS] ok positions=%s", len(positions))
+    return {"safe_mode": safe_mode, "mismatches": mismatches}
+
