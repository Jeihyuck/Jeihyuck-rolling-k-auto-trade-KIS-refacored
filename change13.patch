@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+import json
+import logging
+import os
+from datetime import date, datetime
+from pathlib import Path
+from typing import Dict, Iterable, Iterator, List, Tuple
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_LEDGER_DIR = Path("bot_state/ledger")
+
+
+def _today() -> date:
+    return datetime.utcnow().date()
+
+
+def _event_path(base_dir: Path, kind: str, day: date) -> Path:
+    ymd = day.strftime("%Y%m%d")
+    return base_dir / "events" / f"{kind}_{ymd}.jsonl"
+
+
+def _ensure_dir(path: Path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+
+
+class EventStore:
+    def __init__(self, base_dir: Path = DEFAULT_LEDGER_DIR) -> None:
+        self.base_dir = Path(base_dir)
+
+    def append_event(self, kind: str, payload: Dict) -> Path:
+        day = _today()
+        path = _event_path(self.base_dir, kind, day)
+        _ensure_dir(path)
+        record = dict(payload)
+        record.setdefault("ts", datetime.utcnow().isoformat())
+        record.setdefault("type", kind.upper())
+        line = json.dumps(record, ensure_ascii=False)
+        reasons: List[str] = []
+        try:
+            with open(path, "a", encoding="utf-8") as f:
+                f.write(line + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            logger.info(
+                "[EVENT-STORE] append kind=%s path=%s type=%s",
+                kind,
+                path,
+                record.get("type"),
+            )
+        except Exception as exc:
+            reasons.append(str(exc))
+            logger.exception(
+                "[EVENT-STORE] append failed kind=%s path=%s reasons=%s", kind, path, reasons
+            )
+        return path
+
+    def load_events(
+        self,
+        kind: str | None = None,
+        *,
+        date_range: Tuple[date | None, date | None] | None = None,
+    ) -> Iterator[Dict]:
+        kinds = [kind] if kind else self._available_kinds()
+        start, end = date_range or (None, None)
+        for k in kinds:
+            for path in self._iter_paths(k, start=start, end=end):
+                yield from self._iter_file(path)
+
+    def _available_kinds(self) -> List[str]:
+        events_dir = self.base_dir / "events"
+        kinds: set[str] = set()
+        if not events_dir.exists():
+            return []
+        for path in events_dir.glob("*.jsonl"):
+            name = path.stem
+            if "_" in name:
+                kinds.add(name.split("_", 1)[0])
+        return sorted(kinds)
+
+    def _iter_paths(
+        self, kind: str, *, start: date | None, end: date | None
+    ) -> Iterable[Path]:
+        events_dir = self.base_dir / "events"
+        if not events_dir.exists():
+            return []
+        for path in sorted(events_dir.glob(f"{kind}_*.jsonl")):
+            try:
+                ymd = path.stem.split("_", 1)[1]
+                path_date = datetime.strptime(ymd, "%Y%m%d").date()
+            except Exception:
+                continue
+            if start and path_date < start:
+                continue
+            if end and path_date > end:
+                continue
+            yield path
+
+    def _iter_file(self, path: Path) -> Iterator[Dict]:
+        if not path.exists():
+            return
+        try:
+            with open(path, "r", encoding="utf-8") as f:
+                for line in f:
+                    if not line.strip():
+                        continue
+                    try:
+                        yield json.loads(line)
+                    except json.JSONDecodeError:
+                        logger.warning(
+                            "[EVENT-STORE] skip invalid json path=%s line=%s",
+                            path,
+                            line.strip()[:200],
+                        )
+        except Exception:
+            logger.exception("[EVENT-STORE] load failed path=%s", path)
